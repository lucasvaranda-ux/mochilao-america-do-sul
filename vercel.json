{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/peru",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/peru.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas/lancamentos.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/whatch/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/whatch/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/inv",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/inv.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/inv/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/inv/(.*).(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/inv/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/telas-perguntar.mjs": {
      "maxDuration": 300
    },
    "api/whatch-gosto.mjs": {
      "maxDuration": 60
    },
    "api/whatch-avisos.mjs": {
      "maxDuration": 300
    },
    "api/inv-cotacao.mjs": {
      "maxDuration": 15
    },
    "api/inv-busca.mjs": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/(index|peru|telas|inv)(\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "(whatch|whattowatch)(\\.madeinbr\\.app|[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/",
      "permanent": false,
      "missing": [
        {
          "type": "header",
          "key": "x-whatch-interno"
        }
      ]
    },
    {
      "source": "/(index|peru|telas|inv)(\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "inv(\\.madeinbr\\.app|-[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/",
      "permanent": false,
      "missing": [
        {
          "type": "header",
          "key": "x-inv-interno"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/whatch-avisos",
      "schedule": "0 11 * * *"
    }
  ]
}

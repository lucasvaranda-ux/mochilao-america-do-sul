{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/peru",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/peru.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/telas/lancamentos.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/whatch/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/whatch/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/inv",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/inv.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/inv/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/inv/(.*).(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/inv/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/estudos",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/estudos.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/estudos/ler",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/estudos/cofre.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/estudos/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/estudos/dados/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/estudos/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/estudos/(.*).(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/estudos/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/egito",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/egito.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/egito/(.*).(json|js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/egito/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/egito/(.*).(png|svg|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "estudos(\\.madeinbr\\.app|-[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/telas-perguntar.mjs": {
      "maxDuration": 300
    },
    "api/whatch-gosto.mjs": {
      "maxDuration": 60
    },
    "api/whatch-avisos.mjs": {
      "maxDuration": 300
    },
    "api/inv-cotacao.mjs": {
      "maxDuration": 30,
      "includeFiles": "inv/empresas.json"
    },
    "api/inv-busca.mjs": {
      "maxDuration": 15,
      "includeFiles": "inv/busca.json"
    }
  },
  "redirects": [
    {
      "source": "/(index|peru|telas|inv|estudos|egito)(\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "(whatch|whattowatch)(\\.madeinbr\\.app|[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/",
      "permanent": false,
      "missing": [
        {
          "type": "header",
          "key": "x-whatch-interno"
        }
      ]
    },
    {
      "source": "/(index|peru|telas|inv|estudos|egito)(\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "inv(\\.madeinbr\\.app|-[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/",
      "permanent": false,
      "missing": [
        {
          "type": "header",
          "key": "x-inv-interno"
        }
      ]
    },
    {
      "source": "/(index|peru|telas|inv|estudos|egito)(\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "estudos(\\.madeinbr\\.app|-[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/",
      "permanent": false,
      "missing": [
        {
          "type": "header",
          "key": "x-estudos-interno"
        }
      ]
    },
    {
      "source": "/(index|peru|telas|inv|estudos|egito)(\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "egito(\\.madeinbr\\.app|-[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/",
      "permanent": false,
      "missing": [
        {
          "type": "header",
          "key": "x-egito-interno"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "estudos(\\.madeinbr\\.app|-[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/estudos/ler"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "estudos(\\.madeinbr\\.app|-[a-z0-9-]*\\.vercel\\.app)"
        }
      ],
      "destination": "/estudos/ler.html"
    }
  ],
  "crons": [
    {
      "path": "/api/whatch-avisos",
      "schedule": "0 11 * * *"
    }
  ]
}
